# Copy this file to local.env and fill in real values.
# Never upload local.env to a public web directory or commit it.
ARCTIC_ADMIN_USERNAME=user42
ARCTIC_ADMIN_PASSWORD=replace-with-a-long-random-password
ARCTIC_DISCORD_WEBHOOK_URL=replace-with-a-new-device-reset-webhook
ARCTIC_KEY_PING_WEBHOOK_URL=replace-with-a-key-activation-webhook
ARCTIC_STAFF_ORDER_WEBHOOK_URL=replace-with-a-staff-orders-webhook
ARCTIC_ERROR_WEBHOOK_URL=replace-with-loader-error-webhook
ARCTIC_PUBLIC_API_URL=https://api.example.com
# Render persistent disk mount. For Supabase instead, set ARCTIC_SUPABASE_URL and ARCTIC_SUPABASE_SERVICE_KEY.
ARCTIC_DATA_DIR=/var/data
ARCTIC_SUPABASE_URL=
ARCTIC_SUPABASE_SERVICE_KEY=
ARCTIC_ALLOWED_ORIGIN=https://your-keypanel-domain.example
ARCTIC_ADMIN_TOKEN=
HOST=127.0.0.1
PORT=5000
